# ProperT — copy sections into backend/.env and frontend/.env.local as needed.
# Never commit real secrets.

# --- Backend (backend/.env) ---

DATABASE_URL="postgresql://admin:admin123@localhost:5433/propert?schema=public"

# Required: min 16 characters. Use a long random value in production.
JWT_SECRET="change-me-to-a-long-random-string"

FRONTEND_URL="http://localhost:3000"
PORT=4000

# MinIO (match docker-compose defaults or your overrides)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=propert-uploads
AWS_REGION=us-east-1

# --- Frontend (frontend/.env.local) ---

# NEXT_PUBLIC_API_URL=http://localhost:4000
