# Copy to .env and adjust values
DATABASE_URL="postgresql://admin:admin123@localhost:5433/propert?schema=public"

# Signing key for access JWTs (min 16 chars; use a long random value in production)
JWT_SECRET="change-me-to-a-long-random-string"

FRONTEND_URL="http://localhost:3000"
PORT=4000

# Auth0 (optional). When AUTH0_DOMAIN, AUTH0_CLIENT_ID, and AUTH0_CLIENT_SECRET are set,
# email/password login and registration use Auth0; Google/Apple use /authorize + POST /auth/oauth/exchange.
# Enable the Password grant for your Auth0 app (APIs → your app → Grant Types) for custom login forms.
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# Optional API audience for tokens (leave unset if you only use OIDC userinfo).
# AUTH0_AUDIENCE=""
# Database connection name for POST /dbconnections/signup (default Username-Password-Authentication).
# AUTH0_DB_CONNECTION=Username-Password-Authentication

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=propert-uploads
AWS_REGION=us-east-1
