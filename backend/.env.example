DATABASE_URL="postgresql://admin:admin123@localhost:5433/propert?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
FRONTEND_URL="http://localhost:3000"
PORT=4000
REDIS_URL="redis://localhost:6379"

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_DB_CONNECTION=Username-Password-Authentication

# Storage (S3 / MinIO)
# For local dev: set S3_ENDPOINT to point at your MinIO container.
# For production AWS S3: leave S3_ENDPOINT unset (comment it out or delete it).
AWS_ACCESS_KEY_ID=CHANGE_ME          # local dev: minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME     # local dev: minioadmin123
S3_ENDPOINT=http://localhost:9000   # remove this line for real AWS S3
S3_BUCKET_NAME=propert-uploads
AWS_REGION=us-east-1
