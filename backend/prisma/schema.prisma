generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SEEKER
  OWNER
  AGENT
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  COMMERCIAL
  LAND
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ListingStatus {
  FOR_SALE
  FOR_RENT
}

// Models
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  
  firstName String
  lastName  String
  avatar    String?
  
  role      UserRole @default(SEEKER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Relations
  listings  Listing[]
  bookings  Booking[]
  
  sentMessages Message[]
  chats        UserConversation[]
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  status      ListingStatus @default(FOR_SALE)
  price       Decimal  @db.Decimal(12, 2)
  size        Float
  bedrooms    Int      @default(0)
  bathrooms   Int      @default(0)
  
  type        PropertyType
  
  // Address & Location
  address     String
  latitude    Float?
  longitude   Float?
  
  // Media & Features
  images      String[] // Postgres array
  features    String[] // Postgres array
  videoUrl    String?
  virtualTourUrl String?
  
  // Metrics
  views       Int      @default(0)

  // Relations
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  bookings    Booking[]
  availabilities Availability[]
  conversations Conversation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([price])
  @@index([ownerId])
}

model Availability {
  id        String   @id @default(uuid())
  
  dayOfWeek Int      // 0-6 (Sun-Sat)
  startTime String   // "09:00"
  endTime   String   // "17:00"
  
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Booking {
  id        String   @id @default(uuid())
  
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)
  notes     String?
  
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  
  seekerId  String
  seeker    User     @relation(fields: [seekerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([seekerId])
}

// Messaging System

model Conversation {
  id        String   @id @default(uuid())
  
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  
  participants UserConversation[]
  messages     Message[]
  
  updatedAt    DateTime @updatedAt
}

model UserConversation {
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@id([userId, conversationId])
}

model Message {
  id             String   @id @default(uuid())
  content        String
  read           Boolean  @default(false)
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])

  createdAt      DateTime @default(now())
}
